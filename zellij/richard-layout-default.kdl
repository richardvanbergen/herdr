layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                hide_frame_for_single_pane "false"

                format_left   "{mode}#[fg=#89B4FA,bold] {session} {tabs}"
                format_right  "{datetime}"
                format_space  ""

                mode_normal  "#[bg=#89B4FA,fg=#1e1e2e,bold] N "
                mode_locked  "#[bg=#f38ba8,fg=#1e1e2e,bold] L "
                mode_resize  "#[bg=#fab387,fg=#1e1e2e,bold] R "
                mode_pane    "#[bg=#a6e3a1,fg=#1e1e2e,bold] P "
                mode_tab     "#[bg=#94e2d5,fg=#1e1e2e,bold] T "
                mode_scroll  "#[bg=#f5c2e7,fg=#1e1e2e,bold] S "
                mode_move    "#[bg=#cba6f7,fg=#1e1e2e,bold] M "
                mode_tmux    "#[bg=#ffc387,fg=#1e1e2e,bold] T "

                tab_normal   "#[fg=#6C7086] {index}: {name} "
                tab_active   "#[fg=#cdd6f4,bold] {index}: {name} "

                datetime        "#[fg=#6C7086] {format} "
                datetime_format "%H:%M"
            }
        }
    }

// zj-radar:block begin
    new_tab_template {
        pane focus=true
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab_template name="ui" {
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    swap_tiled_layout name="vertical" {
        ui max_panes=5 {
            pane split_direction="vertical" {
                pane
                pane { children; }
            }
        }
        ui max_panes=8 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
            }
        }
        ui max_panes=12 {
            pane split_direction="vertical" {
                pane { children; }
                pane { pane; pane; pane; pane; }
                pane { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="horizontal" {
        ui max_panes=4 {
            pane
            pane
        }
        ui max_panes=8 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
        ui max_panes=12 {
            pane {
                pane split_direction="vertical" { children; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
                pane split_direction="vertical" { pane; pane; pane; pane; }
            }
        }
    }

    swap_tiled_layout name="stacked" {
        ui min_panes=5 {
            pane split_direction="vertical" {
                pane
                pane stacked=true { children; }
            }
        }
    }
// zj-radar:block end
}
